# CertiFlow Environment Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db" # Local SQLite for zero-setup execution, or postgresql://certiflow:certiflow_secure_password@localhost:5432/certiflow_db
